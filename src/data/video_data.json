    {
      "id": "scene-13",
      "number": 13,
      "start": 232.46,
      "duration": 15.1,
      "audio_file": "scenes/scene_13.wav",
      "narration": "Engineers tried the obvious fix. Sharpen the nose. Push the air aside sooner. But a long cone creates new problems. More weight. Crosswind instability. Tail wag. And the boom is still there. The shape was wrong, not the sharpness.",
      "visual": {
        "kind": "component",
        "component": "PulseTimeline",
        "variant": null,
        "beats": [
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
