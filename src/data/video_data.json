    {
      "id": "scene-12",
      "number": 12,
      "start": 218.355,
      "duration": 13.975,
      "audio_file": "scenes/scene_12.wav",
      "narration": "Boom. Not from the wheels. Not from the motor. From the air. A pressure spike leaves the tunnel and slaps the neighborhood. Four hundred meters. Windows vibrate. Glass cracks. The train never touched a thing. The air did all of it.",
      "visual": {
        "kind": "component",
