          }
        ]
      },
      "badge": {
        "text": "CAR SHAKE",
        "start": 10.87,
        "duration": 3.2,
        "accent": "cyan"
      },
      "jcut": {
        "file": "audio/sfx/sfx_warning_pulse.mp3",
        "offset_frames": 30
      },
      "sfx": null,
      "beat_sfx": []
    },
    {
      "id": "scene-17",
      "number": 17,
      "start": 319.01,
      "duration": 22.85,
      "audio_file": "scenes/scene_17.wav",
      "narration": "Wind tunnels and test trains became the only way forward. Engineers built experimental sets and pushed them past three hundred fifty. They changed the nose, the tail, the gap between cars, and the tunnel portal. Each test produced a cleaner pressure trace and a new failure. The problem was not one part. It was the whole path the air had to follow. They needed a shape from somewhere else.",
