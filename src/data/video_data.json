    {
      "id": "scene-08",
      "number": 8,
      "start": 130.605,
      "duration": 21.55,
      "audio_file": "scenes/scene_08.wav",
      "narration": "Picture a bottle of sparkling wine. The cork pops because pressure inside has nowhere to go. A tunnel portal is that cork. The compression wave arrives after a few seconds, and part of it escapes into open air. The rest reflects back as an expansion wave. The escaping part is the boom. It is not the train hitting anything. It is the air arriving all at once.",
      "visual": {
        "kind": "component",
        "component": "PulseTimeline",
        "variant": null,
        "beats": [
          {
            "kind": "cad",
            "files": [],
