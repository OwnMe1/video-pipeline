    },
    {
      "id": "scene-09",
      "number": 9,
      "start": 152.155,
      "duration": 21.6,
      "audio_file": "scenes/scene_09.wav",
      "narration": "The boom is low and heavy. Most of its energy sits below twenty hertz, where the ear is weak and buildings are not. Windows rattle. Loose panels buzz. In the worst reports, glass cracks in homes four hundred meters from the portal. Residents hear a distant thump, then another, every time a fast train leaves. The source is not the engine. It is the tunnel mouth.",
      "visual": {
        "kind": "component",
        "component": "ScaleComparator",
        "variant": null,
        "beats": [
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
            "label": "scene_09 beat 1"
          },
          {
