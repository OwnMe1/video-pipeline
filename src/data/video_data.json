            "layout": "full",
            "label": "scene_11 beat 3"
          }
        ]
      },
      "badge": {
        "text": "PRESSURE GAIN",
        "start": 7.537,
        "duration": 3.2,
        "accent": "cyan"
      },
      "jcut": {
        "file": "audio/sfx/sfx_digital_tick.mp3",
        "offset_frames": 30
