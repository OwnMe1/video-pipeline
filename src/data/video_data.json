            "label": "scene_15 beat 2"
          },
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
            "label": "scene_15 beat 3"
          }
        ]
      },
      "badge": {
        "text": "BAD TRADEOFF",
        "start": 20.769,
        "duration": 3.2,
        "accent": "cyan"
      },
      "jcut": {
        "file": "audio/sfx/sfx_digital_tick.mp3",
        "offset_frames": 30
      },
      "sfx": null,
      "beat_sfx": []
    },
    {
      "id": "scene-16",
      "number": 16,
      "start": 294.135,
      "duration": 24.875,
      "audio_file": "scenes/scene_16.wav",
      "narration": "At three hundred fifty kilometers per hour, a small yaw angle becomes a large side force. The train rocks. Pressure pulses from the tunnel hit the cars in sequence. Windows hum. Doors vibrate. The pantograph, the arm that touches the wire, sings at its own frequency. Engineers measured vibrations that passengers described as a shudder through the floor. Speed turns a minor shape error into a structural event.",
      "visual": {
        "kind": "component",
        "component": "StressGauge",
        "variant": null,
        "beats": [
          {
            "kind": "cad",
