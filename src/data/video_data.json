            "layout": "full",
            "label": "scene_09 beat 2"
          },
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
            "label": "scene_09 beat 3"
          }
        ]
      },
      "badge": {
        "text": "FOUR HUNDRED METERS",
        "start": 11.928,
        "duration": 3.2,
        "accent": "cyan"
      },
      "jcut": {
        "file": "audio/sfx/sfx_digital_tick.mp3",
        "offset_frames": 30
