    },
    {
      "id": "scene-10",
      "number": 10,
      "start": 173.755,
      "duration": 21.975,
      "audio_file": "scenes/scene_10.wav",
      "narration": "Sound travels through air at about three hundred forty meters per second. A pressure wave can cross a four hundred meter gap in little more than one second. At the portal, the wave radiates outward like a speaker cone. Low frequencies bend around buildings and travel farther. That is why the complaint comes from far away. Distance does not protect you. Geometry does.",
      "visual": {
        "kind": "component",
        "component": "StressGauge",
        "variant": null,
        "beats": [
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
            "label": "scene_10 beat 1"
          },
          {
