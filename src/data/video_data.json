    {
      "id": "scene-07",
      "number": 7,
      "start": 115.655,
      "duration": 14.95,
      "audio_file": "scenes/scene_07.wav",
      "narration": "The wave reaches the portal. It does not stop. It reflects, radiates, and turns into sound. A low thud, then a crack. That is tunnel boom. The piston built the bullet. The portal fires it. And the target is everything outside.",
      "visual": {
        "kind": "component",
        "component": "HudOverlay",
        "variant": null,
        "beats": [
          {
            "kind": "cad",
            "files": [],
