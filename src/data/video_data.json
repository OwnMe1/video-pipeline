            "layout": "full",
            "label": "scene_10 beat 2"
          },
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
            "label": "scene_10 beat 3"
          }
        ]
      },
      "badge": {
        "text": "SPEED OF SOUND",
        "start": 0.183,
        "duration": 3.2,
        "accent": "cyan"
      },
      "jcut": {
        "file": "audio/sfx/sfx_warning_pulse.mp3",
        "offset_frames": 30
      },
      "sfx": null,
      "beat_sfx": []
    },
    {
      "id": "scene-11",
      "number": 11,
      "start": 195.73,
      "duration": 22.125,
      "audio_file": "scenes/scene_11.wav",
      "narration": "Tunnel shape makes it worse. A long bore with a constant cross section lets the wave steepen. A portal with a sharp edge turns more energy into sound. Two trains passing add their pulses. Old tunnels were cut for slower trains, with tighter bores and blunt portals. The faster the service, the harder the air fights back. Every design choice becomes part of the cannon.",
      "visual": {
        "kind": "component",
        "component": "MechanismBreakdown",
        "variant": null,
        "beats": [
          {
