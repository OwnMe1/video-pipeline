            "layout": "full",
            "label": "scene_13 beat 3"
          }
        ]
      },
      "badge": {
        "text": "NOSE PROBLEM",
        "start": 2.943,
        "duration": 3.2,
        "accent": "orange"
      },
      "jcut": {
        "file": "audio/sfx/sfx_warning_pulse.mp3",
        "offset_frames": 30
      },
      "sfx": null,
      "beat_sfx": []
    },
    {
      "id": "scene-14",
      "number": 14,
      "start": 247.56,
      "duration": 22.55,
      "audio_file": "scenes/scene_14.wav",
      "narration": "Imagine sticking your hand out of a moving car and tilting it. The air does not slide cleanly. It separates, curls, and buffets your palm. A train nose works the same way. If the change in shape is too sudden, the flow breaks away. Vortices form. The train feels a sideways kick that repeats with every tunnel. That kick is the beginning of the vibration problem.",
      "visual": {
        "kind": "component",
        "component": "MechanismBreakdown",
        "variant": null,
        "beats": [
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
            "label": "scene_14 beat 1"
          },
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
            "label": "scene_14 beat 2"
          },
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
            "label": "scene_14 beat 3"
          }
        ]
      },
      "badge": {
        "text": "SHARP NOSE",
        "start": 1.687,
        "duration": 3.2,
        "accent": "cyan"
      },
      "jcut": {
        "file": "audio/sfx/sfx_crisp_transition.mp3",
        "offset_frames": 30
      },
      "sfx": null,
      "beat_sfx": []
    },
    {
      "id": "scene-15",
      "number": 15,
      "start": 270.11,
      "duration": 24.025,
      "audio_file": "scenes/scene_15.wav",
      "narration": "A blunt nose compresses the air hard and early. A needle nose compresses it gently, but it is long, heavy, and fragile in crosswinds. The ideal is a shape that changes pressure gradually without adding mass or instability. That is a narrow design window. Most early high speed trains lived outside it, and passengers felt the difference. The nose became a compromise between aerodynamics and structure.",
      "visual": {
        "kind": "component",
        "component": "ScaleComparator",
        "variant": null,
        "beats": [
          {
            "kind": "cad",
            "files": [],
            "layout": "full",
            "label": "scene_15 beat 1"
          },
          {
